# --- Respawn: fleet-wide defaults ---
# Tracked template for `.env.defaults` at the workspace root. Copy to `.env.defaults`
# on a fresh clone and fill in your own account.
#
# Every service layers over this file, so a key set here applies to the whole fleet and
# needs to be declared once instead of sixteen times. Precedence, lowest first:
#
#   .env.defaults                      <- this file
#   apps/<project>/.env                shared across a project's variants
#   apps/<...>/<service>/.env          the service itself, always wins
#
# A service that belongs somewhere else just re-declares the key locally — that is how
# apps/ut99/variants/modded targets a different account from everything else.

# AWS target. AWS_PROFILE is the one that decides where a deploy actually lands, and
# AWS_ACCOUNT_ID is checked against the caller identity before any deploy, so a stale
# value here fails loudly rather than silently deploying into the wrong account.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_PROFILE=respawn
