# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/

# Environment
.env
.env.*
!.env.example
# The fleet-wide AWS defaults every service layers under. The real file holds an account
# id, so only the template is tracked — `.env.*` above would otherwise swallow it too.
!.env.defaults.example

# Coverage
coverage/

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

vite.config.*.timestamp*

# CDK synth artifacts (the root /cdk.out rule missed the nested app dir)
cdk.out/
cdk.context.json

# In-package build output (respawn-mcp)
apps/*/dist/

# Generated by respawn-mcp build
apps/respawn-mcp/src/manifests.generated.ts

# Game content payloads (maps, wads, models, sounds) for variants that ship custom
# content. Tens of MB of binaries that would live in git history for ever; they are
# reproducible from the archive with `pnpm tfc:content:fetch` and are still captured
# by the image content hash, because Docker's build context ignores .gitignore.
apps/*/variants/*/content/

# World-save library for services whose state round-trips through S3 (valheim).
# Gitignored for size, but UNLIKE apps/*/variants/*/content/ these are NOT
# reproducible: a world is live state, not content fetched from an archive, and
# this directory is its master copy. Back it up somewhere that is not this repo.
#
# The .respawn.json provenance stamps inside are small and ARE meaningful in review —
# but they are meaningless without the save they describe, so they stay with it.
apps/*/worlds/
apps/*/variants/*/worlds/

# BepInEx plugin payloads. Reproducible from the variant's tracked mods.txt with
# `pnpm valheim:mods:fetch <variant>`, so this is the content/ relationship, not the
# worlds/ one.
apps/*/variants/*/mods/

# Spike campaign payloads — refetchable from the Workshop, never committed.
# S4 pulls these with `steamcmd +login anonymous +workshop_download_item 550 <id>`;
# the ids are recorded in the spike, so the manifest is the doc and the VPK is the payload.
lab/s4-campaign/

# S10 VScript addon payloads — refetchable from the Workshop ids recorded in the
# spike (3022416274 Left 4 Bots 2, 2634208272 Left 4 Lib).
lab/s10-vscript/

# Compiled SourceMod plugins — the .sp is tracked, the .smx is built.
# Image builds compile from source (see the variant Dockerfile), so nothing
# shipped depends on an artifact somebody built by hand.
apps/*/plugins/build/

# S11 build payload — the curated pack's assembled tree (355 MB), reproducible with
# `git clone --depth 1 https://github.com/SNWCreations/l4d2-modded-server`.
lab/s11-full-stack/payload/

# S12 probe build output — same rule as apps/*/plugins/build/, and for the same
# reason: the .sp is the artifact, the .smx is rebuilt from it.
lab/s12-vscript-orders/build/
