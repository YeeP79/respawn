# --- Respawn: Team Fortress Classic (shared base) --- TRACKED TEMPLATE
# Layered under every variant in variants/. Only knobs common to all TFC builds live
# here; identity, secrets and the map/mod payload are per-variant. Gitignored; keep
# .env.example in sync.
#
# AWS target comes from .env.defaults at the workspace root (personal account).

CPU=256
MEMORY=512

# GoldSrc game port. 26900/udp is the HLDS master-server/heartbeat port.
CONTAINER_PORT=27015
HOST_PORT=27015
PROTOCOL=UDP
ADDITIONAL_PORTS=26900/udp
# rcon is TCP on the same number — INTERNAL_PORTS, never ADDITIONAL_PORTS, so the
# rcon-control sidecar reaches it over loopback with no public ingress.
INTERNAL_PORTS=27015/tcp

ENABLE_IDLE_SHUTDOWN=true
# GoldSrc answers A2S on the game port; netstat cannot see UDP players.
IDLE_CHECK_METHOD=a2s
IDLE_TIMEOUT_MINUTES=30

ENABLE_RCON_CONTROL=true
RCON_PROTOCOL=goldsrc

# Both variants build locally (FROM jives/hlds:tfc + a shim), so neither sets IMAGE_URI.
# loader.ts rejects UPDATE_CHECK=image without one.
UPDATE_CHECK=build
