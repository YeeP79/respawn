# --- Respawn: TFC "vanilla" variant (stock jives/hlds:tfc) ---
# Layers over apps/tfc/.env. Stock TFC — no custom maps, no Metamod/AMXX.
# Gitignored; keep .env.example in sync.

# Suffixed identity: the modded build is canonical and keeps the bare `tfc` name,
# so this one gets its own stack, cluster and secret namespace.
SERVICE_NAME=tfc-vanilla
SERVICE_DISPLAY_NAME="Team Fortress Classic (Vanilla)"

CONTAINER_COMMAND=+log on +maxplayers 12 +map 2fort

# Its own secret path — secrets are per service, not per project.
SECRET_REFS=RCON_PASSWORD=sm:respawn/tfc-vanilla/rcon

GAME_ENV_SERVERNAME="Respawn TFC (Vanilla)"
