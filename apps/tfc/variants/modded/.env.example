# --- Respawn: TFC "modded" variant (skill maps + Metamod/AMX Mod X) ---
# Layers over apps/tfc/.env. Gitignored; keep .env.example in sync.

# Canonical build — keeps the bare `tfc` name, so the existing respawn-dev-tfc
# stack, cluster and secret paths carry over unchanged. The stock build is
# tfc-vanilla.
SERVICE_NAME=tfc
SERVICE_DISPLAY_NAME="Team Fortress Classic"

# Still a regular TFC server that also carries skill maps, so it boots 2fort.
# The 20 conc/rocket maps are reached by vote (mapchooser) or `changelevel`
# through the MCP. mapcycle.txt is what the vote draws from.
CONTAINER_COMMAND=+log on +maxplayers 12 +map 2fort

# AMXX loads modules and writes logs on top of the game; 512 MiB is tight once
# 20 maps and the plugin set are resident. CPU=256 permits 512-2048 MiB.
MEMORY=1024

# RCON_PASSWORD is the GoldSrc rcon the sidecar uses. AMXX_ADMIN_PASSWORD is a
# SEPARATE credential for the in-game `amx_` admin surface — different system,
# different password, both injected as ECS secrets and written to cfg by the shim.
# Never GAME_ENV_* or CONTAINER_COMMAND: both land in the task definition in
# plaintext, and loader.ts rejects a credential-looking name in either.
SECRET_REFS=RCON_PASSWORD=sm:respawn/tfc/rcon,AMXX_ADMIN_PASSWORD=sm:respawn/tfc/amxx-admin

GAME_ENV_SERVERNAME="Respawn TFC"
GAME_ENV_AMXX_ADMIN_NAME=admin
# Minutes per map. Must not be 0 — see respawn-init.sh: a zero timelimit makes
# every changelevel bounce back to the boot map and disables map voting.
GAME_ENV_TIMELIMIT=30

# FastDL. HLDS throttles its own file transfer to 8 kB/s, so without this a new
# client pulling ~49 MB of custom maps and wads will time out rather than join.
# Point it at an HTTP(S) mirror of the tfc/ tree — see `pnpm tfc:content:publish`.
# The bucket exists (created 2026-08-27, personal account, us-east-1) but is still
# EMPTY. Leave this unset until `pnpm tfc:content:publish respawn-fastdl-847378615943
# respawn` has actually mirrored the tree: an empty value disables FastDL cleanly,
# whereas a URL pointing at an empty bucket makes every client 404 on every file,
# which is worse than no FastDL at all.
#   GAME_ENV_FASTDL_URL=https://respawn-fastdl-847378615943.s3.amazonaws.com/tfc
GAME_ENV_FASTDL_URL=
