# --- Respawn: Left 4 Dead 2 — VANILLA variant ---
# Stock upstream image, no mods, no rcon transport. Layered over apps/l4d2/.env.
#
# KEEPS THE BARE PROJECT NAME on purpose. This variant IS the service that used to live
# at apps/l4d2, and the shared stack owns one ECR repository per service name — renaming
# it would read as a deletion and deadlock every deploy in the fleet until the old stack
# was destroyed (CLAUDE.md). The modded build takes the suffix instead.

# Service identity
SERVICE_NAME=l4d2
SERVICE_DISPLAY_NAME="Left 4 Dead 2 Server"

# Image (upstream — no local build needed)
IMAGE_URI=left4devops/l4d2:latest


# RCON password — injected as an ECS secret under the same env var name
# the image already reads. Set it with:  pnpm respawn -> Secrets -> l4d2
SECRET_REFS=RCON_PASSWORD=sm:respawn/l4d2/rcon


# --- Addons / Mods ---
# There are none here, and that is what this variant is for: a stock server, nothing to
# install, and no rcon transport (ENABLE_RCON_CONTROL is unset), so nothing can drive it
# mid-game. If you want mods, bots, or the agent bridge, deploy `l4d2-modded` — the
# variants exist so the two do not have to be the same server.

# Update checks — `pnpm respawn:check-updates` compares these against the
# values recorded at the last deploy (SSM: /respawn/<svc>/state/...).
# left4devops installs L4D2 via SteamCMD at container start.
UPDATE_CHECK=image,steam:222860

# The hostname players see in the browser.
GAME_ENV_HOSTNAME=Respawn L4D2
