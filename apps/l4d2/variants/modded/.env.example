# --- Respawn: Left 4 Dead 2 — MODDED variant ---
# Tracked template for apps/l4d2/variants/modded/.env. Layered over apps/l4d2/.env
# (the overlay wins on a collision). Copy to `.env` on a fresh clone.
#
# What this variant IS: the stack S11/S13/S14/S15 measured — ~49 SourceMod plugins,
# 13 extensions, the L4DToolZ slot machinery, Left 4 Bots 2, All4Dead2's 12-command
# director surface, and respawn_director, the agent's bridge.
#
# What it COSTS a joining player: nothing. Every plugin here is server-side, and the
# three VScript VPKs carry only .nut files — no models, materials, maps or sounds
# (S10). The one thing that WOULD cost a client install is a custom campaign, and
# there is deliberately none: a client without the campaign connects, is admitted as
# a player, and dies on `Host_Error: CMapLoadHelper::Init`, and the server cannot
# push it (S4, S9 — zero HTTP requests to a live FastDL host, and no
# host_workshop_*/ugc/sv_allowdownload on this build).

# Service identity. The SUFFIX is deliberate: `l4d2` belongs to variants/vanilla,
# which is the service that used to live at apps/l4d2. Taking the bare name here
# would read to the shared stack as deleting that service and would deadlock every
# deploy in the fleet (CLAUDE.md).
SERVICE_NAME=l4d2-modded
SERVICE_DISPLAY_NAME="Left 4 Dead 2 (modded — bots, director, agent bridge)"

# AWS target — COMMENTED OUT ON PURPOSE. Without these three keys this service deploys to
# the fleet default from the workspace-root .env.defaults (the personal account).
#
# The live deployment of this variant runs in the New Western marketplace-dev account, so
# a machine taking that server over must UNCOMMENT these. They are not active in the
# template because a fresh clone should not silently aim at a corporate account.
#
# All three are required TOGETHER — deploy() preflights AWS_ACCOUNT_ID against
# sts get-caller-identity, so a personal account id with work credentials is refused. That
# is the guard working, not an obstacle.
#
# us-east-2 is deliberate: marketplace-dev's us-east-1 is at its VPC quota and SharedStack
# creates a VPC rather than looking one up, so a deploy there fails with VpcLimitExceeded.
# Secrets are per account AND per region, so SECRET_REFS entries must exist in us-east-2.
#
# BEWARE `pnpm respawn`: it hardcodes `--profile respawn` and the CLI flag WINS over the
# value below, so it will preflight the wrong identity and refuse. Invoke the CLI directly:
#   npx tsx --conditions development apps/cli/src/index.ts
#
# AWS_ACCOUNT_ID=679252296174
# AWS_REGION=us-east-2
# AWS_PROFILE=marketplace-dev--dev


# No IMAGE_URI: this variant BUILDS. The upstream image is config-env driven and
# would serve fine, but the mods, the C++ runtime swap and respawn_director all have
# to be baked in. UPDATE_CHECK must agree — loader.ts rejects the mismatch, and
# `build` is only valid with IMAGE_URI absent.
UPDATE_CHECK=build

# 49 plugins, a VScript VM and an extra sidecar are not free. Must be a valid Fargate
# pair: CPU=1024 allows 2048-8192 MiB.
CPU=1024
MEMORY=2048

# rcon-control: Source RCON over TCP on the same number as the game's UDP port. The
# port is in the shared base's INTERNAL_PORTS, so it gets a task mapping the sidecar
# reaches over loopback and NO public ingress.
ENABLE_RCON_CONTROL=true
RCON_PROTOCOL=source
RCON_PORT=27015

# The rcon password. Injected as an ECS secret under the env var the image already
# reads — never GAME_ENV_ or CONTAINER_COMMAND, both of which land in the task
# definition in plaintext. Set it with:  pnpm respawn -> Secrets -> l4d2-modded
#
# Note the upstream entrypoint puts it on the srcds command line (`+rcon_password`),
# so it is visible in `ps` INSIDE the container. That is upstream behaviour shared
# with the vanilla variant, not something this build introduces; the secret is still
# kept out of the task definition, which is what SECRET_REFS is for.
SECRET_REFS=RCON_PASSWORD=sm:respawn/l4d2-modded/rcon,JOIN_PASSWORD=sm:respawn/l4d2-modded/join-pw
#
# JOIN_PASSWORD is sv_password. It CANNOT be a GAME_ENV_ value: loader.ts's credential
# heuristic matches the PASSWORD in the name and rejects it at load, and it would land in
# the task definition in plaintext anyway. respawn-init.sh writes it into a cfg file the
# game execs — the same shim that already writes Left4Lib's admins.txt.
#
# Note the ASYMMETRY with RCON_PASSWORD above: the upstream entrypoint puts the rcon
# password on the srcds command line, so that one is visible in `ps` inside the container.
# sv_password is not — it never touches argv.

# Without this the agent has no transport and every order fails, so it must be loud
# at deploy time rather than at 2am. preflight() rejects placeholders as well as
# absence.
REQUIRED_ENV_VARS=RCON_PASSWORD,JOIN_PASSWORD

# Left4Lib's admin list, written to ems/left4lib/cfg/admins.txt before the server starts.
# Comma-separated `STEAM_x:y:z //label` entries; the label is required by the parser, not
# decoration — a line without one is dropped with a warning nobody reads.
#
# THE AGENT DOES NOT NEED THIS. respawn_director v3 goes through VScript, which is not
# behind Left4Lib's gate (S12, measured with no admins file at all). This is for the
# HUMAN: the direct binds in client/respawn.cfg (F11/F12/\) use the chat-command path,
# which IS gated, and without this they are silently inert — no message, no log line.
GAME_ENV_L4B_ADMINS=STEAM_1:1:14886575 //YeeP

GAME_ENV_HOSTNAME=Respawn L4D2 [modded]
# The entrypoint passes +motd_enabled unconditionally, so an unset value becomes a
# bare flag. Set it rather than leave srcds parsing an empty argument.
GAME_ENV_MOTD=0

# sv_allow_lobby_connect_only DEFAULTS TO 1 and refuses a direct `connect` outright —
# a server nobody can join while every health check stays green. sv_logecho makes the
# game's own events reach the console, which is what source-logship.sh ships; without
# it srcds buffers the game log to a file and delivers nothing (measured: created and
# left at 0 bytes while the server ran).
GAME_ENV_EXTRA_ARGS=+sv_allow_lobby_connect_only 0 +sv_logecho 1

# --- Slots: coop past 4 players -------------------------------------------------------
# ENABLED. S6's open question — what the fifth player actually has to do — is answered:
# they join with the console `connect <ip>` command. sv_allow_lobby_connect_only 0 is
# already set in GAME_ENV_EXTRA_ARGS above, which is what makes that work at all.
#
# Read at runtime by respawn-init.sh, which writes cfg/respawn_slots.cfg. That means
# changing this number is a task-definition change and a restart, NOT an image rebuild.
#
# 8 is the number the bundled repair-tail plugins were written against ("5+" and "8+"
# servers). Going past 18 additionally requires raising sv_setmax, which is left at its
# default here — see the shim for why that one is not touched.
GAME_ENV_MAX_PLAYERS=8
#
# The machinery this switches on is already installed and, at 4 players, inert (S5
# measured it byte-identical to base):
#
#   sv_maxplayers         max HUMAN players. Set from MAX_PLAYERS above. -1 restores the
#                         stock 4-player coop check.
#   sv_visiblemaxplayers  the count ADVERTISED to browsers, and nothing else. Set to the
#                         same value, or the server seats 8 and advertises 4.
#   sv_setmax             engine max CLIENTS, default 18. NOT set — 18 already covers 8
#                         humans plus the survivor bots filling the rest.
#
# Both take effect live over rcon too, if you want to try a number before committing it.

# --- Prerequisites ---
# The three Workshop VPKs must be present before the image builds — they are vendored
# and hash-pinned, not fetched from the Workshop, because the Workshop has no version
# concept. Rebuild the payload with:
#
#   apps/l4d2/scripts/fetch-vendor.sh <state-bucket> <aws-profile>
#
# The Dockerfile fails the build if they are missing, rather than producing a server
# whose bots silently do nothing.
