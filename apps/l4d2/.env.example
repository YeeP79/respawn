# --- Respawn: Left 4 Dead 2 — shared base (all variants) ---
# Tracked template for apps/l4d2/.env. Values common to every l4d2 variant; each
# variants/<v>/.env layers its own identity, image, secrets and game-env over this
# (the overlay wins on a collision). Copy to `.env` on a fresh clone.
#
# The AWS target is NOT here — it comes from the workspace-root .env.defaults.

# Container resources. Source engine with nothing loaded is comfortable at 2 GB; the
# modded variant raises CPU in its own .env because 49 plugins and a VScript VM are
# not free. Must be a valid Fargate pair (see loader.ts).
CPU=512
MEMORY=2048

# Primary port (game traffic)
CONTAINER_PORT=27015
HOST_PORT=27015
PROTOCOL=UDP
ADDITIONAL_PORTS=
# Source RCON is TCP on the SAME number as the game's UDP port. INTERNAL_PORTS gives
# it a task mapping so the rcon-control sidecar reaches it over loopback, and NO
# public ingress — an admin port in ADDITIONAL_PORTS would be world-reachable.
INTERNAL_PORTS=27015/tcp

# Idle shutdown — scales the service to 0 after N idle minutes to save cost.
# Source serves every client from one unconnected UDP socket, so the netstat check
# never sees players however many are playing. Ask the game instead (A2S_INFO).
ENABLE_IDLE_SHUTDOWN=true
IDLE_CHECK_METHOD=a2s
IDLE_TIMEOUT_MINUTES=30

# Region: 0=US East, 1=US West, 2=South America, 3=Europe, 4=Asia,
#          5=Australia, 6=Middle East, 7=Africa, 255=Worldwide
GAME_ENV_REGION=0
# Starting map (Dead Center campaign) and mode.
GAME_ENV_DEFAULT_MAP=c1m1_hotel
GAME_ENV_DEFAULT_MODE=coop
GAME_ENV_GAME_TYPES=coop,versus,realism,survival

# --- Prerequisites ---
# No game files or tokens needed — the image downloads everything via SteamCMD on
# first start. That is also why the image is ~16 GB.
