# --- Respawn: CS 1.6 "dm" variant (ReGameDLL free-for-all deathmatch) ---
# Layers over apps/cs16/.env. Gitignored; keep .env.example in sync.

# Suffixed identity: vanilla is canonical and keeps the bare `cs16` name, so this
# gets its own stack, cluster and secret namespace. Vanilla is untouched by this.
SERVICE_NAME=cs16-dm
SERVICE_DISPLAY_NAME="Counter-Strike 1.6 (Deathmatch)"

CONTAINER_COMMAND=+log on +maxplayers 16 +map de_dust2 +sv_lan 0

# AMXX loads modules and writes logs on top of the game. CPU=256 permits 512-2048 MiB.
MEMORY=1024

# RCON_PASSWORD is the GoldSrc rcon the sidecar uses. AMXX_ADMIN_PASSWORD is a
# SEPARATE credential for the in-game `amx_` surface. Both injected as ECS secrets and
# written to cfg by the shim — never GAME_ENV_*/CONTAINER_COMMAND, which land in the
# task definition in plaintext (loader.ts rejects a credential-looking name in either).
SECRET_REFS=RCON_PASSWORD=sm:respawn/cs16-dm/rcon,AMXX_ADMIN_PASSWORD=sm:respawn/cs16-dm/amxx-admin

GAME_ENV_SERVERNAME="Respawn CS 1.6 DM"
GAME_ENV_AMXX_ADMIN_NAME=admin

# --- Deathmatch tuning (ReGameDLL cvars — absent on stock cs.so) ---
# Seconds before a killed player respawns. 0 turns respawn OFF and reverts this to
# round-based CS, which is the one setting that quietly undoes the whole variant.
GAME_ENV_DM_RESPAWN_DELAY=2
# Random spawns rather than team spawns. Uses the map's .nav file; without one
# ReGameDLL falls back to normal spawns rather than failing.
GAME_ENV_DM_RANDOM_SPAWN=1
# Seconds of spawn protection — FFA on round maps invites spawn-camping without it.
GAME_ENV_DM_SPAWN_IMMUNITY=2
# Blocks round-end checks; this is what makes it continuous DM rather than tiny rounds.
GAME_ENV_DM_ROUND_INFINITE=1
# 0 off, 1 infinite clip, 2 infinite backpack ammo.
GAME_ENV_DM_INFINITE_AMMO=2
# Buy time in minutes; -1 always allowed, 0 disables buying.
GAME_ENV_DM_BUYTIME=-1
# Minutes per map. Must not be 0 — AMXX then reads timeleft as 00:00 and voting
# never opens (measured on the TFC build).
GAME_ENV_TIMELIMIT=30
