# --- Respawn: CS 1.6 "kz" variant (Kreedz climbing / bhop) ---
# Layers over apps/cs16/.env. Gitignored; keep .env.example in sync.

SERVICE_NAME=cs16-kz
SERVICE_DISPLAY_NAME="Counter-Strike 1.6 (KZ Climbing)"

# Boots the easiest map in the ramp. sv_lan 0 so it is reachable publicly.
CONTAINER_COMMAND=+log on +maxplayers 16 +map kz_bhopwarehouse +sv_lan 0

# AMXX plus ReAPI, AmxxEasyHttp and a 224 MB map payload. CPU=256 permits 512-2048 MiB.
MEMORY=1024

SECRET_REFS=RCON_PASSWORD=sm:respawn/cs16-kz/rcon,AMXX_ADMIN_PASSWORD=sm:respawn/cs16-kz/amxx-admin,MYSQL_ROOT_PASSWORD=sm:respawn/cs16-kz/mysql-root

GAME_ENV_SERVERNAME="Respawn KZ"
GAME_ENV_AMXX_ADMIN_NAME=admin

# --- MySQL sidecar ---
# The KZ timer needs a database to FUNCTION, not merely to persist: kz_core calls
# natives provided by kz_sql_core, so without the SQL plugins the timer itself fails to
# load with "unknown function". With the sidecar it also keeps records, tops and saved
# positions.
#
# Storage is EPHEMERAL — a Fargate task has no volume, so records live as long as the
# task and are gone when the server sleeps. That is the deliberate trade for a
# scale-to-zero server; durable records mean RDS (always-on cost). Treat these as
# session scores.
ENABLE_MYSQL_SIDECAR=true
MYSQL_DATABASE=kreedz
MYSQL_ROOT_PASSWORD_VAR=MYSQL_ROOT_PASSWORD

# Which generated cycle to run: all | starter | climb | bhop | hard | tier-<name>.
# Cycles are ordered easiest-first. `starter` is Beginner+Easy — the right default for
# a group new to KZ, since a hard climb with no timer to show progress just reads as a
# wall. Switching cycle is an env change and a restart, NOT a rebuild.
GAME_ENV_MAPCYCLE=all

# --- KZ movement ---
# THE KZ cvar: air acceleration governs mid-air steering, which every jump technique
# depends on. 100 is the standard the maps and their published records assume. Stock CS
# is 10, on which most KZ maps are simply impossible — do not "fix" this to the default.
GAME_ENV_AIRACCELERATE=100
# Stock values. Changing either invalidates comparison against any published time.
GAME_ENV_GRAVITY=800
GAME_ENV_MAXSPEED=320
# Minutes per map; must not be 0 or AMXX reads timeleft as 00:00 and voting never opens.
GAME_ENV_TIMELIMIT=45

# FastDL. 224 MB of maps against HLDS's own 8 kB/s transfer cap means a joiner without
# this will time out rather than connect. Publish BEFORE playing:
#   pnpm respawn --action ... / MCP publish_content, then set this.
# Left empty until the content is actually up: a URL pointing at an empty prefix makes
# every client 404 on every file.
GAME_ENV_FASTDL_URL=
