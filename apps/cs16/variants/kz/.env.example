# --- Respawn: CS 1.6 "kz" variant (Kreedz climbing / bhop) ---
# Layers over apps/cs16/.env. Gitignored; keep .env.example in sync.

SERVICE_NAME=cs16-kz
SERVICE_DISPLAY_NAME="Counter-Strike 1.6 (KZ Climbing)"

# Boots the easiest map in the ramp. sv_lan 0 so it is reachable publicly.
CONTAINER_COMMAND=+log on +maxplayers 16 +map kz_bhopwarehouse +sv_lan 0

# Overrides the base cs16 CPU=256/MEMORY=512, and both halves are forced by the
# sidecars rather than by the game. This variant runs four of them, and ECS requires
# the sum of the containers' reservations to fit inside the task's:
#
#   idle-shutdown 64 / 128 MiB   rcon-control 32 / 128 MiB
#   mysql        128 / 512 MiB   mysql-backup  64 / 128 MiB
#   ------------------------------------------------------- 288 CPU / 896 MiB
#
# CPU=256 therefore does not synthesise at all — CDK rejects it with "the sum of all
# container cpu values cannot be greater than the value of the task cpu", which names
# no service and reads like a bug in the stack.
#
# The two halves are not equally forgiving. Container `cpu` is a RELATIVE SHARE, not a
# cap, and the game container reserves none — so HLDS bursts into whatever the sidecars
# are not using, and 512 is ample for a single-threaded GoldSrc server. `memoryLimitMiB`
# is a HARD limit, so the 896 MiB the sidecars claim is genuinely gone: at MEMORY=1024
# that would leave HLDS 128 MiB to hold a 224 MB map payload, and it would OOM. 2048
# leaves ~1.1 GB, which is the number that actually matters here.
#
# CPU=512 permits 1024-4096 MiB (loader.ts validates the pair against the Fargate matrix).
CPU=512
MEMORY=2048

# All three exist in Secrets Manager (847378615943 / us-east-1), created by the Secrets
# CLI action, which pipes the value on stdin and never puts it in argv. Values are
# generated 24-char alphanumeric: each lands inside a double-quoted config string, and
# MYSQL_ROOT_PASSWORD additionally passes through a `sed` replacement in
# respawn-init.sh, where `&`, `\` and `|` would corrupt the line.
#
#   respawn/cs16-kz/rcon         rcon_password in server.cfg; the rcon-control
#                                sidecar's write transport reads the same value.
#   respawn/cs16-kz/amxx-admin   AMXX admin password written into configs/users.ini
#                                against GAME_ENV_AMXX_ADMIN_NAME below.
#   respawn/cs16-kz/mysql-root   MySQL sidecar root password. Load-bearing three times
#                                over: the database, kz_sql_password for the timer, and
#                                the backup container's dump/restore.
#
# Read one back with:
#   aws secretsmanager get-secret-value --secret-id respawn/cs16-kz/rcon \
#     --profile respawn --region us-east-1 --query SecretString --output text
# Rotate with the Secrets CLI action, never by editing here — no value belongs in a
# .env, and .env.example is tracked.
SECRET_REFS=RCON_PASSWORD=sm:respawn/cs16-kz/rcon,AMXX_ADMIN_PASSWORD=sm:respawn/cs16-kz/amxx-admin,MYSQL_ROOT_PASSWORD=sm:respawn/cs16-kz/mysql-root

GAME_ENV_SERVERNAME="Respawn KZ"
GAME_ENV_AMXX_ADMIN_NAME=admin

# --- MySQL sidecar ---
# The KZ timer needs a database to FUNCTION, not merely to persist: kz_core calls
# natives provided by kz_sql_core, so without the SQL plugins the timer itself fails to
# load with "unknown function". With the sidecar it also keeps records, tops and saved
# positions.
#
ENABLE_MYSQL_SIDECAR=true
MYSQL_DATABASE=kreedz
MYSQL_ROOT_PASSWORD_VAR=MYSQL_ROOT_PASSWORD

# Records survive the scale-to-zero cycle by round-tripping a dump through S3: restore
# on start, dump every MYSQL_BACKUP_INTERVAL_SECONDS, and dump again on SIGTERM. A
# Fargate task has no volume, so without this every record dies when the server idles
# out after 30 minutes — which removes the point of a timer.
#
# The interval dump is the load-bearing one, not the shutdown one: a task can die
# without ever delivering SIGTERM (spot reclaim, OOM, crash), and relying on shutdown
# alone would lose the whole session.
#
# NOT EFS and NOT RDS. MySQL/MariaDB on NFS is unsupported by both projects — it needs
# POSIX locking and fsync semantics NFS does not reliably provide, and the documented
# failure is silent corruption rather than an error. RDS is correct and durable but is
# an always-on bill for a server that exists to be off.
#
# This bucket is PRIVATE and must stay that way: a dump holds player records. Do NOT
# point it at the FastDL bucket, whose whole purpose is being public-read.
# The bucket exists with all four public-access blocks on, versioning enabled, and
# AES256 default encryption. It is NOT part of any stack, so it survives a destroy
# and must be recreated by hand if the service ever moves account or region. The
# task role's grant is scoped to this prefix, not the bucket (mysql-sidecar.ts).
MYSQL_BACKUP_S3_URI=s3://respawn-state-847378615943/cs16-kz/kreedz.sql.gz
MYSQL_BACKUP_INTERVAL_SECONDS=300

# Which generated cycle to run: all | starter | climb | bhop | hard | tier-<name>.
# Cycles are ordered easiest-first. `starter` is Beginner+Easy — the right default for
# a group new to KZ, since a hard climb with no timer to show progress just reads as a
# wall. Switching cycle is an env change and a restart, NOT a rebuild.
GAME_ENV_MAPCYCLE=all

# --- KZ movement ---
# THE KZ cvar: air acceleration governs mid-air steering, which every jump technique
# depends on. 100 is the standard the maps and their published records assume. Stock CS
# is 10, on which most KZ maps are simply impossible — do not "fix" this to the default.
GAME_ENV_AIRACCELERATE=100
# Stock values. Changing either invalidates comparison against any published time.
GAME_ENV_GRAVITY=800
GAME_ENV_MAXSPEED=320
# Minutes per map; must not be 0 or AMXX reads timeleft as 00:00 and voting never opens.
GAME_ENV_TIMELIMIT=45

# FastDL. 224 MB of maps against HLDS's own 8 kB/s transfer cap means a joiner without
# this will time out rather than connect. Publish BEFORE playing:
#   pnpm respawn --action ... / MCP publish_content, then set this.
# Left empty until the content is actually up: a URL pointing at an empty prefix makes
# every client 404 on every file.
GAME_ENV_FASTDL_URL=
