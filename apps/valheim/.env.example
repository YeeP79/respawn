# --- Respawn: Valheim — shared base (all variants) ---
# Values common to every valheim variant. Each variants/<v>/.env layers its own
# identity, world, secrets and mod config over this file (the overlay wins on a
# collision). Gitignored; keep .env.example in sync.
#
# The AWS target is NOT declared here — it comes from the workspace .env.defaults.

# Image (upstream — no local build needed). The same image serves both variants:
# BepInEx is a runtime switch (GAME_ENV_BEPINEX), not a different build.
IMAGE_URI=ghcr.io/lloesche/valheim-server:latest

# Container resources
CPU=1024
MEMORY=4096

# Primary port (game traffic)
CONTAINER_PORT=2456
HOST_PORT=2456
PROTOCOL=UDP
# 2457 is the Steam query port. 2458 is gameport+2, which mods using RPC need for
# their own channel — harmless on vanilla, required on modded.
ADDITIONAL_PORTS=2457/udp,2458/udp

# Persistent storage (world data, backups, and BepInEx plugins — all under /config)
ENABLE_PERSISTENT_STORAGE=true
PERSISTENT_MOUNT_PATH=/config

# Idle shutdown — uses the image's built-in HTTP status endpoint
ENABLE_IDLE_SHUTDOWN=true
IDLE_CHECK_METHOD=http
IDLE_STATUS_ENDPOINT=http://localhost/status.json
IDLE_TIMEOUT_MINUTES=30

# World-save rotation. The S3 PREFIX is per variant, not here: a modded world and a
# vanilla world must never share a bucket prefix, or a rotation could put one into the
# other's server. See the variant .env files.
ENABLE_WORLD_SYNC=true
WORLD_SYNC_INTERVAL_SECONDS=300

# Common game env
GAME_ENV_SERVER_PORT=2456
GAME_ENV_STATUS_HTTP=true
GAME_ENV_BACKUPS=true
GAME_ENV_UPDATE_CRON=*/15 * * * *

# Update checks — lloesche installs Valheim via SteamCMD at container start.
UPDATE_CHECK=image,steam:896660

# Required values — checked at deploy time (preflight). SERVER_PASS comes from each
# variant's SECRET_REFS, so this only guards against the ref being removed.
REQUIRED_ENV_VARS=SERVER_PASS
