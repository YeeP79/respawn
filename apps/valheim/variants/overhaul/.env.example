# --- Respawn: Valheim — OVERHAUL rung — everything, ONE-WAY, ~500 MB client install ---
# Everything: the loot rung, the building rung, and the Therzie content suite on top.
# Hundreds of new weapons, creatures, spells and pieces.
#
# THE TOP OF THE LATTICE. It carries the union of `loot` and `build`, so a world can climb
# here from either — and from nowhere back down. It is the only rung a world on `loot` or
# `build` can move to at all.
#
# THE REAL COST IS THE CLIENT INSTALL, not the server. Around 500 MB that every player
# must have at matching versions before they can connect; the Therzie packages alone are
# ~440 MB of that. Hand out the modpack built from mods.lock.
#
# A VARIANT IS A RULESET, NOT A WORLD. It declares which mods load and what the server can
# be driven with. Which world runs here is a separate, deploy-time choice, and a world can
# live in several variants' libraries at once — see DEPLOY_PROMPTS at the bottom.
#
# Layered over apps/valheim/.env (and the workspace .env.defaults).

# Builds its own image (the rcon shim), unlike the vanilla variant. IMAGE_URI is set in
# the shared apps/valheim/.env, so it must be explicitly emptied here — an empty value
# reads as unset — and UPDATE_CHECK must follow it from `image` to `build`, which the
# loader enforces rather than letting the pair drift.
IMAGE_URI=
UPDATE_CHECK=build,steam:896660

SERVICE_NAME=valheim-overhaul
SERVICE_DISPLAY_NAME="Valheim Server (Overhaul, PC/Steam only)"

# The name carries the constraint because the constraint is invisible otherwise: an
# Xbox/Game Pass player cannot join a modded server at all, and their failure looks like a
# network fault rather than a deliberate exclusion.
GAME_ENV_SERVER_NAME="Respawn Valheim [Overhaul / PC only]"

# Its OWN secrets, not another variant's — naming is respawn/<service>/<name>, and a
# separate service means separate entries that must exist before the first deploy:
#   echo -n "$PASS" | pnpm respawn --non-interactive --action secrets \
#     --service valheim-overhaul --secret SERVER_PASS
SECRET_REFS=SERVER_PASS=sm:respawn/valheim-overhaul/server-pass,RCON_PASSWORD=sm:respawn/valheim-overhaul/rcon

# --- BepInEx ---
# The image installs BepInExPack Valheim when this is set and copies everything from
# /config/bepinex/plugins/ into the live plugin directory at startup. Plugins get there
# via the world-sync sidecar (WORLD_SYNC_PLUGIN_SOURCE below), not baked into an image,
# so changing the mod set is a publish and a restart rather than a rebuild.
#
# BEPINEX and VALHEIM_PLUS are mutually exclusive; the image refuses both.
GAME_ENV_BEPINEX=true

# CROSSPLAY IS INCOMPATIBLE WITH MODS and must stay off on every modded variant. With
# crossplay enabled Valheim uses PlayFab networking instead of Steam, BepInEx cannot hook
# that path, and plugins silently do not load — the server comes up looking healthy and
# entirely unmodded. Anyone on Xbox/Game Pass cannot join a modded server at all.
GAME_ENV_CROSSPLAY=false

# Every client must run the SAME plugin set and versions, or they will fail to connect
# (or desync). The variant's tracked mods.lock is the authoritative flat list to match;
# export the same set from r2modman/Thunderstore as a modpack code and hand it to players.

# --- World save rotation ---
# Own prefix. Variants never share one: a rotation that could put one server's world into
# another's is exactly the accident the whole provenance system exists to prevent.
WORLD_SYNC_S3_PREFIX=s3://respawn-state-847378615943/valheim-overhaul

# Where the sidecar pulls plugins from, under the prefix above. Synced into
# /config/bepinex/plugins/ before the game starts, so the plugin set is settled by the
# time BepInEx scans it.
WORLD_SYNC_PLUGIN_SOURCE=plugins

# --- Remote administration (mid-game) ---
# Vanilla Valheim has NO remote console: an admin must be a logged-in player, and even
# then only Group A commands (kick/ban/unban/banned/save/ping) work on a dedicated
# server. Mid-game admin from outside the game is therefore a MODDED-ONLY capability,
# and it is why even the lightest modded rung exists.
#
# ValheimRcon (from mods-admin.txt) adds an rcon listener, and the fleet already speaks
# that protocol — so the existing rcon-control sidecar and the whole MCP command surface
# work here with no new transport.
ENABLE_RCON_CONTROL=true
RCON_PROTOCOL=source
RCON_PORT=2458
# Loopback only. The rcon-control sidecar reaches it inside the task; putting an admin
# port in ADDITIONAL_PORTS would open it to 0.0.0.0/0.
INTERNAL_PORTS=2458/tcp
# The plugin is config-FILE driven, so the password cannot be a GAME_ENV_ value — it
# would sit in the task definition in plaintext. It is written by the image's
# PRE_SERVER_RUN_HOOK (see Dockerfile + ../../respawn-rcon-config.sh), which is the only
# point that has BOTH the injected secret and the live BepInEx tree under /opt.

# Always `modded` on a BepInEx variant, and NEVER `vanilla` — even here, where every
# declared plugin is world-safe. The sidecar DOWNGRADES this to `vanilla` when it finds
# that every plugin actually present is world-safe, so `modded` is self-correcting and
# `vanilla` is not: hardcoding `vanilla` would keep stamping saves clean after somebody
# adds a world-altering plugin, which is the one direction of error that destroys a world.
WORLD_FLAVOR=modded

# NO DEPLOY_PROMPTS YET, DELIBERATELY. This variant's worlds/ library is empty, so
# there is no world to offer. Deploy preflight refuses a world-sync service that names
# no world and prints the library, which is the correct failure: publish a world in
# first, then list it here.
#
#   pnpm valheim:world:publish overhaul '<world name>'
#   DEPLOY_PROMPTS=WORLD_NAME:select:<world name>|<another>
#
# Naming a world here that the library does not hold is worse than naming none:
# Valheim does not error on an unknown world, it generates an empty one under that
# name and runs it happily.
