# --- Respawn: Valheim — VANILLA variant ---
# Unmodded. This is the canonical build, so it keeps the bare project name and the
# stack, EFS volume and secrets that already exist under it.
#
# Layered over apps/valheim/.env (and the workspace .env.defaults). Only the deltas
# belong here.

SERVICE_NAME=valheim
SERVICE_DISPLAY_NAME="Valheim Server"

GAME_ENV_SERVER_NAME="Respawn Valheim"

# Server password — injected as an ECS secret, never plaintext (AGENT_PROMPT.md §7).
# Set it with the Secrets CLI action before the first deploy.
SECRET_REFS=SERVER_PASS=sm:respawn/valheim/server-pass

# --- World save rotation ---
# Own prefix, separate from the modded variant's. This is the second of the three
# barriers keeping a modded world out of this server; the other two are the separate
# EFS volume (different stack) and the flavor stamp checked at publish and at seed.
WORLD_SYNC_S3_PREFIX=s3://respawn-state-847378615943/valheim

# This server refuses to load a world that has ever run modded. Mod-added objects are
# stored as ZDOs carrying the mod's prefab hashes; without the mod those hashes do not
# resolve and Valheim destroys the objects on load. Valheim writes objects as a
# continuous stream, so the damage is frequently unrecoverable rather than cosmetic —
# which is why this is a refusal and not a warning.
WORLD_FLAVOR=vanilla

# Which world to run is asked at deploy time — there is deliberately NO default.
# Valheim does not error on an unknown world name, it CREATES an empty world under it,
# so a defaulted name lets a routine deploy fabricate a world wearing a real one's name.
# A deploy that names none is refused by preflight, which lists this library's worlds.
#
# Rotating worlds is a deploy-time choice — pnpm respawn -> Deploy -> valheim -> pick.
# Placeholders — replace with the world names in this variant's worlds/ directory.
# Keep in sync with variants/vanilla/worlds/.
DEPLOY_PROMPTS=WORLD_NAME:select:respawn-world|respawn-world-archive
