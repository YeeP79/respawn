# --- Respawn: Valheim — MODDED variant (BepInEx) ---
# A separate service: its own stack, its own EFS volume, its own S3 prefix, its own
# secret. Nothing it does can reach the vanilla server's world.
#
# Layered over apps/valheim/.env (and the workspace .env.defaults).

# Builds its own image (the rcon shim), unlike the vanilla variant. IMAGE_URI is set in
# the shared apps/valheim/.env, so it must be explicitly emptied here — an empty value
# reads as unset — and UPDATE_CHECK must follow it from `image` to `build`, which the
# loader enforces rather than letting the pair drift.
IMAGE_URI=
UPDATE_CHECK=build,steam:896660

SERVICE_NAME=valheim-modded
SERVICE_DISPLAY_NAME="Valheim Server (Modded, PC/Steam only)"

# The name carries the constraint because the constraint is invisible otherwise:
# an Xbox/Game Pass player cannot join at all, and their failure looks like a
# network fault rather than a deliberate exclusion. Cheap to say, expensive to
# diagnose. (Everyone on this server plays on PC, so it is a label, not a loss.)
GAME_ENV_SERVER_NAME="Respawn Valheim [Modded / PC only]"

# Its OWN secret, not the vanilla one — naming is respawn/<service>/<name>, and a
# separate service means a separate entry that must exist before the first deploy:
#   echo -n "$PASS" | pnpm respawn --non-interactive --action secrets \
#     --service valheim-modded --secret SERVER_PASS
SECRET_REFS=SERVER_PASS=sm:respawn/valheim-modded/server-pass,RCON_PASSWORD=sm:respawn/valheim-modded/rcon

# --- BepInEx ---
# The image installs BepInExPack Valheim when this is set and copies everything from
# /config/bepinex/plugins/ into the live plugin directory at startup. Plugins get there
# via the world-sync sidecar (WORLD_SYNC_PLUGIN_SOURCE below), not baked into an image,
# so changing the mod set is a publish and a restart rather than a rebuild.
#
# BEPINEX and VALHEIM_PLUS are mutually exclusive; the image refuses both.
GAME_ENV_BEPINEX=true

# CROSSPLAY IS INCOMPATIBLE WITH MODS and must stay off here. With crossplay enabled
# Valheim uses PlayFab networking instead of Steam, BepInEx cannot hook that path, and
# plugins silently do not load — the server comes up looking healthy and entirely
# unmodded. Anyone on Xbox/Game Pass cannot join a modded server at all.
GAME_ENV_CROSSPLAY=false

# Every client must run the SAME plugin set and versions, or they will fail to connect
# (or desync). Export the set from r2modman/Thunderstore as a modpack code and hand it
# to players; keep mods.txt as the server-side record of what that set is.

# --- World save rotation ---
# Own prefix. A world published here is stamped `modded` on first boot and can never
# go back to the vanilla server.
WORLD_SYNC_S3_PREFIX=s3://respawn-state-847378615943/valheim-modded

# Where the sidecar pulls plugins from, under the prefix above. Synced into
# /config/bepinex/plugins/ before the game starts, so the plugin set is settled by the
# time BepInEx scans it.
WORLD_SYNC_PLUGIN_SOURCE=plugins

# Worlds that have run here are stamped with this and are one-way: a modded world is
# refused by the vanilla server. Going the other way (vanilla world -> modded server)
# is allowed and is how you start modding a world — it stamps it permanently.

# --- Remote administration (mid-game) ---
# Vanilla Valheim has NO remote console: an admin must be a logged-in player, and even
# then only Group A commands (kick/ban/unban/banned/save/ping) work on a dedicated
# server. Mid-game admin from outside the game is therefore a MODDED-ONLY capability,
# which is a second, independent reason for this variant to exist.
#
# ValheimRcon adds an rcon listener. Declared world-safe in mods.txt: it opens a socket
# and runs commands, and writes no prefabs into the save — so a world that runs here with
# only this plugin stays stamped `vanilla` and can go back to the vanilla server.
ENABLE_RCON_CONTROL=true
RCON_PROTOCOL=source
RCON_PORT=2458
# Loopback only. The rcon-control sidecar reaches it inside the task; putting an admin
# port in ADDITIONAL_PORTS would open it to 0.0.0.0/0.
INTERNAL_PORTS=2458/tcp
# The plugin is config-FILE driven, so the password cannot be a GAME_ENV_ value — it
# would sit in the task definition in plaintext. It is written by the image's
# PRE_SERVER_RUN_HOOK (see Dockerfile + respawn-rcon-config.sh), which is the only point
# that has BOTH the injected secret and the live BepInEx tree under /opt. The world-sync
# sidecar cannot do it: it mounts /config, and the plugin never reads from there.

WORLD_FLAVOR=modded

# Placeholders — replace with the world names in this variant's worlds/ directory.
# No GAME_ENV_WORLD_NAME default: preflight
# refuses a deploy that names no world, so choosing one is always an explicit act.
DEPLOY_PROMPTS=WORLD_NAME:select:respawn-world|respawn-world-archive
