# --- Respawn: UT99 "modded" variant (roemer/ut99-server, full mod set) ---
# Tracked template for apps/ut99/variants/modded/.env. Layers over apps/ut99/.env
# (shared base) — only the deltas that make this the modded build live here.

# Service identity — bare `ut99` keeps the deployed stack / cluster / secret names
# (this is the canonical UT99 server; the vanilla variant is `ut99-vanilla`).
SERVICE_NAME=ut99
SERVICE_DISPLAY_NAME="Unreal Tournament 99 (Modded)"

# LOCAL BUILD — deliberately no IMAGE_URI. The mod set still comes from upstream
# (MonsterHunt, ChaosUT, BunnyTrack, MapVote, ZeroPing, StrangeLove, ... — catalogued in
# rcon-manifest.json under `modData`); the Dockerfile here is that image plus
# respawn-init.sh.
#
# The shim exists for settings the upstream image exposes NO way to set. Its prepare.py
# maps a fixed list of UT_* vars onto ini keys; anything outside it can only be reached
# by an rcon `set`, which writes the in-memory class default and dies with the task.
# Two settings need that today — bUseTranslocator (shipped False for DeathMatchPlus) and
# ServerPackages entries for mods the image ships but never registers.
#
# UPDATE_CHECK overrides the base's `image`: loader.ts rejects UPDATE_CHECK=image on a
# service that builds its own image. The base keeps `image` for ut99-vanilla.
UPDATE_CHECK=build

# Read by respawn-init.sh, not by the upstream prepare.py. UT_TRANSLOCATOR is applied to
# every DeathMatchPlus-derived game type; Assault is excluded, since translocating past
# objectives breaks that mode. UT_EXTRA_SERVERPACKAGES is additive and skips duplicates.
GAME_ENV_UT_TRANSLOCATOR=True
GAME_ENV_UT_EXTRA_SERVERPACKAGES=XPickups,InstaGibPlus_10B,NoSelfDamage

# Passwords — injected as ECS secrets, not plaintext (see AGENT_PROMPT.md §7).
# Three DIFFERENT passwords; the names are not interchangeable:
#   UT_ADMINPWD     -> [Engine.GameInfo] AdminPassword            (in-game `admin login`)
#   UT_WEBADMINPWD  -> [UTServerAdmin.UTServerAdmin] AdminPassword (UWeb console on 5580)
#   UT_GAMEPWD      -> [Engine.GameInfo] GamePassword             (JOIN password)
# Set only the first and the web admin silently keeps the image's baked-in default of
# admin/admin. It is loopback-only (INTERNAL_PORTS, base .env), but one typo moving
# 5580 to ADDITIONAL_PORTS would publish an unauthenticated remote admin console.
#
# UT_GAMEPWD is the only one that keeps strangers OUT: the two admin passwords gate
# privileged commands, not connecting. Drop it and anyone who finds the address on
# 7777/udp can join, since the security group opens that port to 0.0.0.0/0 and
# UT_DOUPLINK=False only withholds the server from the master lists. All three are
# mapped from env var to .ini key by the image's /prepare.py.
#
# Note it cannot be a GAME_ENV_ var: loader.ts's credential heuristic matches the
# `PWD` in the name and rejects GAME_ENV_UT_GAMEPWD at config load, because
# GAME_ENV_* lands in the task definition in plaintext. It must be a SECRET_REFS
# entry, and the secret must exist before the first deploy or the task dies with
# ResourceInitializationError.
SECRET_REFS=UT_ADMINPWD=sm:respawn/ut99/admin-pwd,UT_WEBADMINPWD=sm:respawn/ut99/admin-pwd,UT_GAMEPWD=sm:respawn/ut99/game-pwd
# The gamespy read transport takes no credentials; RCON_PASSWORD_VAR only satisfies
# the loader's "rcon needs a secret" check. Points at an existing secret.
RCON_PASSWORD_VAR=UT_ADMINPWD

# rcon-control WRITE transport — the UWeb admin console on 5580 (HTTP Basic auth), the
# same command interpreter an in-game admin reaches after `adminlogin`. The MCP routes
# run_command / set_cvar / rcon here; queries stay on the gamespy read path (base .env).
# RCON_WRITE_PASSWORD_VAR must name a SECRET_REFS entry (never plaintext); RCON_WRITE_USER
# must match the webadmin username (GAME_ENV_UT_WEBADMINUSER below).
RCON_WRITE_PROTOCOL=uweb
RCON_WRITE_PORT=5580
RCON_WRITE_PASSWORD_VAR=UT_WEBADMINPWD
RCON_WRITE_USER=admin

# --- Game-specific environment variables ---
GAME_ENV_UT_SERVERNAME="Respawn UT99"
# A mutator runs ONLY if it appears in this URL. Listing its package in ServerPackages
# (which the image's prepare.py does for every shipped mod) merely replicates the package
# to connecting clients — it does not instantiate anything, so the shipped mutators are
# all inert until named here. Confirm with the `rules` query: an empty `mutators=` means
# none are live.
#
# MVES.MapVote = MapVote Extended. Mind the package name: the mutator class is in MVES.u,
# while MVE2h is the client-side ClientPackage (MVE_Config.ini). `?mutator=MVE2h.MapVote`
# is wrong and fails silently, because the UWeb console reports nothing either way.
# Mutators are a COMMA-separated list, and the list is absolute: whatever a later
# `servertravel ...?mutator=` sends REPLACES this set, so every mutator wanted must be
# named on every travel. Omitting MVES.MapVote from one is how map voting silently
# turns itself off.
#
# Class names, verified against each package's .int in the image — several differ from
# the package name, and a wrong one fails silently:
#   MVES.MapVote                            map voting (package MVE2h)
#   ZeroPingPlus103.ZeroPing                client-side hit detection — SEE WARNING BELOW
#   FlagAnnouncementsV2.FlagAnnouncements   CTF flag callouts
#   WhoPushedMe.WhoPushedMe                 credit for pushing someone to their death
#   SLV205.StrangeMutator                   StrangeLove: redeemers become flyable
#   KickIdlePlayers2.KickIdlePlayers2       kicks idlers
#   NoSelfDamage.NoSelfDamage               nullifies self damage
#   Relics.Relic{Regen,Defense,Speed,Strength,Redemption,Vengeance-as-RelicDeath}
#                                           bonus-pack relics — ONE MUTATOR PER RELIC,
#                                           there is no single "relics" switch, which is
#                                           why they look absent on a stock config
# Do NOT add VoteSys_v12.MutVoteSys alongside MVES.MapVote — they are two competing
# map-vote systems. CCHS4 and EnhancedItems are client-side packages with no mutator
# class (prepare.py deletes CCHS4.int), so they cannot be enabled here.
# ⚠️ ZeroPingPlus103.ZeroPing removed 2026-08-13: with it active the map had NO pickup
# weapons. It replaces every weapon with a ZP_ variant for lag compensation, and here the
# replacement yielded nothing. It logs a clean load and no error — the failure is visible
# only in game — so do not trust the log when testing it. Verify on an EMPTY server.
#
# timelimit is not cosmetic — it is what makes map voting work. MVE opens the vote at
# MATCH END, and with the stock timelimit=0 a match ends only when someone hits
# fraglimit, which on a large map with players joining and leaving often never happens.
# The map then never ends and the vote never opens. Set it via the URL: the image
# exposes no UT_TIMELIMIT env var, and an rcon `set` writes only the in-memory class
# default, which is lost on a task restart.
#
# Deliberately NO ?Translocator= here — measured 2026-08-14 to be useless. The image
# bakes bUseTranslocator PER GAME TYPE (DeathMatchPlus False, CTFGame True), and a URL
# option only affects the type being booted, so booting CTF could never fix DM; MVE also
# composes its own travel URL on a map change and drops it. GAME_ENV_UT_TRANSLOCATOR
# above writes the ini instead, which every game type reads and which survives both a
# map change and a restart.
GAME_ENV_UT_SERVERURL=CTF-Face?game=BotPack.CTFGame?timelimit=15?mutator=MVES.MapVote,FlagAnnouncementsV2.FlagAnnouncements,Relics.RelicRegen,Relics.RelicDefense,Relics.RelicSpeed,Relics.RelicStrength,Relics.RelicRedemption,Relics.RelicDeath
GAME_ENV_UT_MAXPLAYERS=16

# Do NOT announce this server to the public master-server lists. Stock UT99 uplinks to
# twelve of them on boot (utmaster.epicgames.com, master.oldunreal.com, ...), which
# publishes the server's address to anyone browsing. `-lanplay` does not stop it. This
# disables only IpServer.UdpServerUplink; IpServer.UdpServerQuery still answers GameSpy
# on the query port (what the idle-shutdown watchdog probes). Flip to True to list publicly.
GAME_ENV_UT_DOUPLINK=False
# Web admin username; must match RCON_WRITE_USER. Password is the UT_WEBADMINPWD secret.
# Left unset, the image defaults the username to "admin".
GAME_ENV_UT_WEBADMINUSER=admin
